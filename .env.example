# ============================================================================
#  环境变量样例 —— 复制成 .env 后按自己的环境填写
# ----------------------------------------------------------------------------
#  【怎么用】
#    cp .env.example .env
#
#  【安全性】
#    .env 已在 .gitignore 里，永远不会被提交。
#    本文件里【只能出现假值】—— 真密码和真 Key 永远只进 .env。
# ============================================================================

# ----------------------------------------------------------------------------
# 数据库
# ----------------------------------------------------------------------------
# 本地开发：MySQL 跑在本机，DB_HOST 用 127.0.0.1
# Docker 部署：MySQL 是 compose 里的 db 服务，DB_HOST 用 db
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=student_ms_demo
DB_USER=root
DB_PASSWORD=

# ----------------------------------------------------------------------------
# 后端服务
# ----------------------------------------------------------------------------
# Docker 部署时必须改成 0.0.0.0，
# 绑 127.0.0.1 会导致容器外部完全连不上。
APP_HOST=127.0.0.1
APP_PORT=8003
# 开发时热重载用 1，生产用 0
APP_RELOAD=0

# ----------------------------------------------------------------------------
# 知识库小助手 · 模型配置
# ----------------------------------------------------------------------------
#  【三种协议随便切】—— 改一个变量就行，不用动代码。
#
#  方案 A：Anthropic Messages 协议（默认，MiniMax / Claude 走这套）
LLM_PROTOCOL=anthropic
LLM_BASE_URL=https://api.minimax.chat/anthropic/v1
LLM_API_KEY=
LLM_MODEL=MiniMax-M3.1-Flash

# 方案 B：OpenAI 兼容协议
#  能对接 DeepSeek / 通义千问 / 智谱 / Kimi / Ollama / vLLM / LM Studio 等
#LLM_PROTOCOL=openai
#LLM_BASE_URL=https://api.deepseek.com/v1
#LLM_API_KEY=
#LLM_MODEL=deepseek-chat

# 方案 C：Gemini generateContent 协议
#LLM_PROTOCOL=gemini
#LLM_BASE_URL=https://generativativelanguage.googleapis.com/v1beta
#LLM_API_KEY=
#LLM_MODEL=gemini-2.0-flash

# ----------------------------------------------------------------------------
# 模型参数
# ----------------------------------------------------------------------------
# 单次请求超时（秒）—— 大模型响应慢时调大
LLM_TIMEOUT=120
# 单次最大输出 token
LLM_MAX_TOKENS=2048
# 采样温度：问答场景 0.3 足够稳定
LLM_TEMPERATURE=0.3
# 降级模型（逗号分隔）。主模型遇到超时/限流/5xx 时自动换下一个重试。
# 鉴权失败、参数错误这种配置问题不会触发降级。
#LLM_FALLBACK_MODELS=

# ----------------------------------------------------------------------------
# 小助手服务自身
# ----------------------------------------------------------------------------
# Docker 部署时必须改成 0.0.0.0
KB_ASSISTANT_HOST=127.0.0.1
KB_ASSISTANT_PORT=8010
# 允许跨域的来源（逗号分隔）。前端走 Vite 代理时用不到。
KB_ASSISTANT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
KB_ASSISTANT_RELOAD=0
KB_ASSISTANT_LOG_LEVEL=INFO

# 业务行为
KB_ASSISTANT_MAX_ROWS=200        # 单次查询最多返回多少行
KB_ASSISTANT_SQL_TIMEOUT=15      # 单条 SQL 执行超时（秒）
KB_ASSISTANT_MAX_HISTORY=8       # 会话保留多少轮上下文
KB_ASSISTANT_SHOW_SQL=1          # 回答里是否附带执行的 SQL

# ----------------------------------------------------------------------------
# 演示数据重置
# ----------------------------------------------------------------------------
# 【不配 = 重置功能整个关闭】（接口返回 404，前端不显示按钮）
#
# 这是刻意的默认行为：公开部署时如果忘了配，结果应该是「这功能用不了」，
# 而不是「任何人都能重置你的库」。默认必须是安全的那个。
#
# 配了就多一个「一键回到种子基线」的出口 —— 被人删了/改坏了数据可以一键恢复。
# 生成一个强口令：openssl rand -base64 24
#
# 详见 docs/RESET_GUIDE.md
RESET_TOKEN=

# ----------------------------------------------------------------------------
# 小助手的只读数据库账号（可选，但强烈建议）
# ----------------------------------------------------------------------------
# 【为什么要单独开一个只读账号？】
#   小助手会去执行【大模型生成的 SQL】。如果它用 root，
#   一条被诱导的 UPDATE 就能改你的正式数据。
#   数据库权限是第一层防护，代码里的 sql_guard.py 是第二层。两层都要有。
#
# 【怎么建这个账号】
#   CREATE USER 'kb_ro'@'%' IDENTIFIED BY '你的密码';
#   GRANT SELECT ON student_ms_demo.* TO 'kb_ro'@'%';
#   FLUSH PRIVILEGES;
#
# 注意 host 要写 '%'：容器内网访问来自 Docker 网桥，不是 localhost。
#
# 【留空的话】小助手会用上面配置的 DB_USER/DB_PASSWORD（可能是 root，不推荐）
#KB_DB_USER=kb_ro
#KB_DB_PASSWORD=
