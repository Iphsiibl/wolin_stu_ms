# 环境变量（含数据库密码、模型 API Key），绝不能提交
.env
.env.*
!.env.example

# 【例外】前端的 Vite 配置不是密钥，只是路径前缀，必须提交。
# 缺了 frontend/.env.production，生产构建拿不到 VITE_API_BASE=/api，
# 前端所有接口都会调不通（构建不报错，是最难查的那种问题）。
!frontend/.env.production
!frontend/.env.development

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 测试与缓存
.pytest_cache/
.coverage
htmlcov/

# IDE
.idea/
.vscode/

# 数据库备份（含真实数据）
backup_*.sql

# 运行日志（含本机绝对路径，不要外发）
frontend/.runtime/
kb_assistant/logs/
logs/
*.log
