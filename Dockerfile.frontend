# syntax=docker/dockerfile:1
# =====================================================================
# 前端构建 + Nginx 静态服务
# ---------------------------------------------------------------------
# 【为什么是构建 + 运行两阶段？】
#   构建阶段需要 Node（几百 MB），运行阶段只需要 Nginx（几十 MB）。
#   分成两个阶段，最终镜像里【不含 Node、不含 node_modules、不含源码】，
#   镜像体积从 1GB+ 降到几十 MB，服务器拉取和启动都更快。
#
# 【为什么用 npm ci 而不是 npm install？】
#   npm ci 严格按 package-lock.json 装精确版本，可复现；
#   npm install 可能悄悄升级依赖，导致「昨天能构建今天不能」。
#
# 【国内服务器为什么要换源？】
#   官方源在国内很慢，node:22-alpine 装依赖可能要十几分钟。
#   npmmirror 是淘宝的镜像，同步及时。
# =====================================================================

# ---------- 构建阶段 ----------
FROM node:22-alpine AS builder

WORKDIR /app

# 先只拷依赖清单，这样改业务代码不会触发重新 npm ci
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --registry=https://registry.npmmirror.com

# 再拷源码并构建
COPY frontend/ ./
RUN npm run build

# ---------- 运行阶段 ----------
FROM nginx:1.27-alpine

# 生产环境配置（只写路径前缀，不暴露后端地址）
COPY frontend/.env.production /app/.env.production

# Nginx 站点配置：静态资源 + /api 反代 + /kb 反代
COPY nginx.conf /etc/nginx/conf.d/default.conf

# 构建产物
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
