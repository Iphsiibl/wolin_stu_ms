# ============================================================================
#  知识库小助手 —— 环境变量样例
# ============================================================================
#  用法：
#    1. 复制本文件为 kb_assistant/.env
#    2. 把 LLM_API_KEY 填上你的真实 token
#
#  小助手启动时会【先读项目根目录的 .env】，再用本文件覆盖。
#  所以数据库配置（DB_*）在根目录 .env 里维护就行，这里不用重复写；
#  只有你想给小助手单独换一个数据库账号时，才在这里加 DB_USER / DB_PASSWORD。
# ============================================================================

# ============================================================================
#  一、模型配置
# ============================================================================
#  【怎么用】
#    下面是三套「可以整套抄走」的示例，一次只生效一套。
#    改完重启小助手即可 —— 代码不用动一行。
#
#  【向后兼容】
#    新的 LLM_* 没配时，会自动回退到对应的旧变量 MINIMAX_*，
#    再回退到内置默认值。所以老的 .env 一行不改也能继续跑。
#    GET /health 里的 config_sources 会告诉你每个值最终来自哪个变量。
# ============================================================================

# ---- 方案 A：Anthropic Messages 协议（默认，MiniMax / Claude 都走这套）----
# 请求是 POST {LLM_BASE_URL}/messages，鉴权用 x-api-key 头，
# system 是【顶层参数】而不是 role=system 的消息。
LLM_PROTOCOL=anthropic
LLM_BASE_URL=https://api.minimax.chat/anthropic/v1
LLM_API_KEY=
LLM_MODEL=MiniMax-M3.1-Flash

# ---- 方案 B：OpenAI 兼容协议 ----
# 请求是 POST {LLM_BASE_URL}/chat/completions，鉴权用 Authorization: Bearer，
# system 是 messages 里的一条 role=system 的消息。
# 这一套能直接对接：OpenAI / DeepSeek / 通义千问 / 智谱 / Kimi /
#                   Ollama(/v1) / vLLM / LM Studio 等所有 OpenAI 兼容网关。
#
#LLM_PROTOCOL=openai
#LLM_BASE_URL=https://api.deepseek.com/v1
#LLM_API_KEY=
#LLM_MODEL=deepseek-chat
#
# 本地模型举例：
#LLM_BASE_URL=http://127.0.0.1:11434/v1
#LLM_MODEL=qwen2.5:7b
#
# vLLM / LM Studio：
#LLM_BASE_URL=http://127.0.0.1:8000/v1
#LLM_BASE_URL=http://127.0.0.1:1234/v1

# ---- 方案 C：Gemini generateContent 协议 ----
# 请求是 POST {LLM_BASE_URL}/models/{model}:generateContent，
# 鉴权用 x-goog-api-key 头，system 走 systemInstruction。
#
#LLM_PROTOCOL=gemini
#LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
#LLM_API_KEY=
#LLM_MODEL=gemini-2.0-flash

# ============================================================================
#  模型参数的公共配置
# ============================================================================
# 【必填】模型服务的 token。留空的话小助手会提示"未配置"并拒绝调用。
# 只从 .env 读 —— 代码里不写死，日志和 /health 里也永远不会出现。
#LLM_API_KEY=

# 单次请求超时（秒）与最大输出 token
#LLM_TIMEOUT=120
#LLM_MAX_TOKENS=2048
# 采样温度：问答场景 0.3 足够稳定，又不至于像 0 那样呆板
#LLM_TEMPERATURE=0.3

# 自定义请求头（JSON 字符串，可选）。
# 有些网关要带额外的鉴权 / 标识头时才用得上。
# 例：LLM_EXTRA_HEADERS={"X-Title":"kb-assistant"}
# 写错了不会让服务起不来 —— 会忽略掉，并在 /health 的 warnings 里提示。
#LLM_EXTRA_HEADERS=

# 可用模型列表（逗号分隔，可选）。GET /models 会返回它。
# 每项可以写 "模型id" 或 "模型id=显示名"。
# 例：LLM_MODELS=MiniMax-M3.1-Flash,deepseek-chat=DeepSeek Chat
# 没配时只返回当前默认模型。
#LLM_MODELS=

# 降级模型（逗号分隔，可选）。
# 主模型遇到【可重试】的错误（超时 / 限流 / 服务端 5xx / 连不上）时，
# 会自动按顺序换下一个模型重试。
# 鉴权失败、参数错误这种配置问题不会触发降级 —— 换模型也救不回来。
# 例：LLM_FALLBACK_MODELS=MiniMax-M2.7,deepseek-chat
#LLM_FALLBACK_MODELS=

# 服务商标识（可选）。不配的话按 base_url 的域名自动猜，
# 只影响 /health、/models 里的显示名字，不影响实际请求。
# 可选值见 config.py 里的 PROVIDER_DISPLAY_NAMES。
#LLM_PROVIDER=minimax

# ============================================================================
#  旧的 MINIMAX_* 配置（仍然可用，新配置没设时自动回退到这些）
# ============================================================================
#  这些是早期只对接 MiniMax 时的变量名，保留是为了让老的 .env 一行不改也能跑。
#  【新配置 vs 旧配置的对应关系】
#    MINIMAX_BASE_URL     -> LLM_BASE_URL
#    MINIMAX_API_KEY      -> LLM_API_KEY
#    MINIMAX_MODEL        -> LLM_MODEL
#    MINIMAX_TIMEOUT      -> LLM_TIMEOUT
#    MINIMAX_MAX_TOKENS   -> LLM_MAX_TOKENS
#    MINIMAX_TEMPERATURE  -> LLM_TEMPERATURE
#  协议没有对应的旧变量 —— 默认就是 anthropic，跟以前的行为一致。
#
#MINIMAX_API_KEY=
#MINIMAX_BASE_URL=https://api.minimax.chat/anthropic/v1
#MINIMAX_MODEL=MiniMax-M3.1-Flash
#MINIMAX_TIMEOUT=120
#MINIMAX_MAX_TOKENS=2048
#MINIMAX_TEMPERATURE=0.3

# ============================================================================
#  服务自身
# ============================================================================
KB_ASSISTANT_HOST=127.0.0.1
KB_ASSISTANT_PORT=8010
# 允许跨域的来源（逗号分隔）。前端走 Vite 代理时用不到，留着方便直接调试
KB_ASSISTANT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 热重载（开发用）
KB_ASSISTANT_RELOAD=0
KB_ASSISTANT_LOG_LEVEL=INFO

# ============================================================================
#  业务行为
# ============================================================================
# 单次查询最多返回多少行（SQL 没写 LIMIT 时自动补）
KB_ASSISTANT_MAX_ROWS=200
# 单条 SQL 的执行超时（秒）
KB_ASSISTANT_SQL_TIMEOUT=15
# 会话保留多少轮上下文
KB_ASSISTANT_MAX_HISTORY=8
# 是否在回答里附带执行的 SQL
KB_ASSISTANT_SHOW_SQL=1

# ============================================================================
#  可选：给小助手单独的只读数据库账号
# ============================================================================
# 【推荐】正式用起来的时候，强烈建议给小助手开一个只有 SELECT 权限的账号：
#   CREATE USER 'kb_ro'@'localhost' IDENTIFIED BY '你的密码';
#   CREATE USER 'kb_ro'@'127.0.0.1' IDENTIFIED BY '你的密码';
#   GRANT SELECT ON student_ms_demo.* TO 'kb_ro'@'localhost';
#   GRANT SELECT ON student_ms_demo.* TO 'kb_ro'@'127.0.0.1';
#   FLUSH PRIVILEGES;
# 然后把下面两行的值填上（取消注释并替换密码）：
#
# 注意：根目录 .env 里的 DB_USER=root 是【主后端】在用的，
#       只读账号只写在这里，否则主后端会失去写权限。
#
# DB_USER=kb_ro
# DB_PASSWORD=
#
# 密码里有 @ % # 这些字符也没关系 —— db.py 用 URL.create() 构造连接串，
# 会自动做转义。
